{
  "name": "conversor-markdown",
  "version": "1.0.0",
  "private": true,
  "description": "Conversor universal a Markdown (PDF con LaTeX, Word, PowerPoint, Excel, imágenes), 100% en el navegador.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --target=es2020 --sourcemap --outfile=dist/app.js",
    "dev": "npm run build -- --watch",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:navegador": "npm run build && node tests/e2e/navegador.mjs"
  },
  "devDependencies": {
    "esbuild": "0.23.1",
    "katex": "0.16.11",
    "pdfjs-dist": "3.11.174",
    "puppeteer-core": "22.15.0"
  }
}
